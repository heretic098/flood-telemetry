{
  "name": "flood-telemetry",
  "version": "2.3.0",
  "description": "Human-friendly real-time telemetry dashboard for Somerset Levels & Moors flood status",
  "main": "server.js",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "eslint src/js server.js",
    "test": "npm run lint && node --test",
    "snapshot": "node scripts/capture_views.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:links": "node scripts/audit_external_links.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "js-yaml": "^4.1.0",
    "puppeteer-core": "^24.43.1"
  }
}
